data_lake/parquet/
!data_lake/manifests/
simulation/rust/target/

# Per-candidate run directories from the search are transient and are being
# written while git runs; staging them deadlocks on the file lock.
simulation/search/runs/


# Search-derived candidate artifacts: ~460KB each and reproducible from
# parent + settings literal, which run_search.py records in results.json.
simulation/search/*.py
simulation/search/decisive/
